#!name=小米商城
#!desc=捕获小米商城 App 的 Cookie 与 userId，并定时签到。首次使用请打开小米商城 App →「米金商城」→ 点签到触发捕获。
#!arguments=定时签到:15 8 * * *,禁用抓取:小米商城Cookie,禁用MITM:hostname
#!arguments-desc=定时签到：Cron 表达式，默认每日 8:15 执行，格式为「分 时 日 月 周」。\n\n禁用抓取：输入 # 可停用 Cookie 捕获脚本，平时保持默认；需要重新抓 Cookie 时改回。\n\n禁用MITM：输入 # 可停用 MITM 主机名，停用后无法捕获新 Cookie，签到仍按已保存的凭证执行。
#!category=🎈 Bingo
#!system=ios

[Script]
小米商城签到 = type=cron,cronexp="{{{定时签到}}}",wake-system=1,timeout=60,script-path=https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/app/mishop/mishop.js,img-url=https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/mishop.png

{{{禁用抓取}}} = type=http-request,pattern=^https:\/\/shop-api\.retail\.mi\.com\/mtop\/mf\/act\/infinite\/(do|done),requires-body=false,max-size=0,script-path=https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/app/mishop/mishop.cookie.js,img-url=https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/mishop.png

[MITM]
{{{禁用MITM}}} = %APPEND% shop-api.retail.mi.com
