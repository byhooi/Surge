#!name=扫描全能王签到
#!desc=捕获扫描全能王 App 的 Token 并定时签到。首次使用请打开扫描全能王 App 任意页停留，触发 get_user_attribute 请求。
#!arguments=定时签到:15 10 * * *,禁用抓取:扫描全能王Cookie,禁用MITM:hostname
#!arguments-desc=定时签到：Cron 表达式，默认每日 10:15 执行，格式为「分 时 日 月 周」。\n\n禁用抓取：输入 # 可停用 Token 捕获脚本，平时保持默认；需要重新抓 Token 时改回。\n\n禁用MITM：输入 # 可停用 MITM 主机名，停用后无法捕获新 Token，签到仍按已保存的凭证执行。
#!category=🎈 Bingo
#!system=ios

[Script]
扫描全能王签到 = type=cron,cronexp="{{{定时签到}}}",wake-system=1,timeout=120,script-path=https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/app/camscanner/camscanner.js,img-url=https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/camscanner.png

{{{禁用抓取}}} = type=http-request,pattern=^https:\/\/api-cs\.intsig\.net\/user\/cs\/get_user_attribute,requires-body=false,max-size=0,script-path=https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/app/camscanner/camscanner.cookie.js,img-url=https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/camscanner.png

[MITM]
{{{禁用MITM}}} = %APPEND% api-cs.intsig.net
