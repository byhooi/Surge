#!name=奈雪点单签到
#!desc=捕获奈雪点单小程序 accessToken 与门店参数，本地重算签名后每日自动签到。首次使用请在小程序“我的 - 签到”页面打开一次。
#!arguments=定时签到:15 9 * * *,禁用抓取:奈雪获取凭证,禁用MITM:hostname
#!arguments-desc=定时签到：Cron 表达式，默认每日 9:15 执行。\n\n禁用抓取：输入 # 可停用凭证捕获。\n\n禁用MITM：输入 # 可停用 MITM 主机名。
#!category=🎈 Bingo
#!system=ios

[Script]
奈雪点单签到 = type=cron,cronexp="{{{定时签到}}}",wake-system=1,timeout=60,script-path=https://raw.githubusercontent.com/byhooi/Surge/main/Script/naixue_sign.js,script-update-interval=0

{{{禁用抓取}}} = type=http-request,pattern=^https:\/\/tm-web\.pin-dao\.cn\/(?:user|naixue|chayuan|coupon)\/,requires-body=1,max-size=0,binary-body-mode=0,timeout=30,script-path=https://raw.githubusercontent.com/byhooi/Surge/main/Script/naixue_sign.js,script-update-interval=0

[MITM]
{{{禁用MITM}}} = %APPEND% tm-web.pin-dao.cn
