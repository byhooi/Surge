#!name=顺丰速运签到
#!desc=捕获顺丰速运会员页登录凭证，每日自动签到并通知奖励。首次使用请在小程序打开「我的 - 积分」页面一次。
#!arguments=定时签到:30 8 * * *,禁用抓取:顺丰获取凭证,禁用MITM:hostname
#!arguments-desc=定时签到：Cron 表达式，默认每日 8:30 执行，按设备时区计算。\n\n禁用抓取：输入 # 可停用凭证捕获；凭证失效后需要重新开启并打开小程序会员页。\n\n禁用MITM：输入 # 可停用 MITM 主机名。
#!category=🎈 Bingo
#!system=ios

[Script]
顺丰速运签到 = type=cron,cronexp="{{{定时签到}}}",wake-system=1,timeout=60,script-path=https://raw.githubusercontent.com/byhooi/Surge/main/Script/sfsy_sign.js,script-update-interval=0

{{{禁用抓取}}} = type=http-request,pattern=^https:\/\/mcs-mimp-web\.sf-express\.com\/mcs-mimp\/,max-size=0,binary-body-mode=0,timeout=10,script-path=https://raw.githubusercontent.com/byhooi/Surge/main/Script/sfsy_sign.js,script-update-interval=0

[MITM]
{{{禁用MITM}}} = %APPEND% mcs-mimp-web.sf-express.com
