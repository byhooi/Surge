{
  "id": "byhooi.app.sub",
  "name": "Byhooi 脚本订阅",
  "author": "@byhooi",
  "icon": "https://github.com/byhooi.png",
  "repo": "https://github.com/byhooi/Surge",
  "apps": [
    {
      "id": "byhooi_jdcookie_ql",
      "name": "京东 Cookie 青龙同步",
      "keys": [
        "auto_sync_jdcookie_ql",
        "jdCookieList",
        "ql_url",
        "ql_client_id",
        "ql_client_secret",
        "ql_token",
        "ql_token_expires"
      ],
      "descs_html": [
        "<h4 align=\"center\">京东 Cookie 同步到青龙面板</h4>",
        "<p style=\"text-align: center;\">💡 支持获取新 Cookie 时自动同步（需配置青龙信息并开启自动同步），也可点击下方按钮手动触发同步</p>",
        "<h4 align=\"center\">使用说明请查看 <a href=\"https://github.com/byhooi/Surge/tree/main/boxjs\">GitHub 文档</a></h4>"
      ],
      "settings": [
        {
          "id": "auto_sync_jdcookie_ql",
          "name": "获取后自动同步到青龙",
          "val": true,
          "type": "boolean",
          "desc": "开启后，每次抓取到新 Cookie 时自动同步到青龙面板（默认开启）"
        },
        {
          "id": "ql_url",
          "name": "青龙面板地址",
          "val": "",
          "type": "text",
          "placeholder": "http://192.168.1.100:5700",
          "desc": "青龙面板的完整地址，如 http://192.168.1.100:5700"
        },
        {
          "id": "ql_client_id",
          "name": "青龙 Client ID",
          "val": "",
          "type": "text",
          "placeholder": "请输入 Client ID",
          "desc": "在青龙面板系统设置-应用设置中创建应用后获取"
        },
        {
          "id": "ql_client_secret",
          "name": "青龙 Client Secret",
          "val": "",
          "type": "text",
          "placeholder": "请输入 Client Secret",
          "desc": "在青龙面板系统设置-应用设置中创建应用后获取"
        },
        {
          "id": "jdCookieList",
          "name": "Cookie 列表",
          "val": "",
          "type": "textarea",
          "autoGrow": true,
          "rows": 5,
          "desc": "存储的京东 Cookie 列表，JSON 格式"
        }
      ],
      "scripts": [
        {
          "name": "同步 Cookie 到青龙",
          "script": "https://raw.githubusercontent.com/byhooi/Surge/main/Script/jdcookie_ql_sync.js"
        },
        {
          "name": "清空 Cookie 列表",
          "script": "https://raw.githubusercontent.com/byhooi/Surge/main/Script/jdcookie_clear.js"
        }
      ],
      "author": "@byhooi",
      "repo": "https://github.com/byhooi/Surge",
      "icons": [
        "https://raw.githubusercontent.com/byhooi/Surge/main/icon/jd.png",
        "https://raw.githubusercontent.com/byhooi/Surge/main/icon/jd.png"
      ]
    },
    {
      "id": "byhooi_wskey_ql",
      "name": "京东 WSKEY 青龙同步",
      "keys": [
        "wskeyList",
        "ql_url",
        "ql_client_id",
        "ql_client_secret",
        "ql_token",
        "ql_token_expires"
      ],
      "descs_html": [
        "<h4 align=\"center\">手动将 BoxJS 中的京东 WSKEY 同步到青龙面板</h4>",
        "<p style=\"text-align: center;\">⚠️ 注意:此功能为手动同步,需在获取 WSKEY 后点击下方按钮触发同步</p>",
        "<h4 align=\"center\">使用说明请查看 <a href=\"https://github.com/byhooi/Surge/tree/main/boxjs\">GitHub 文档</a></h4>"
      ],
      "settings": [
        {
          "id": "ql_url",
          "name": "青龙面板地址",
          "val": "",
          "type": "text",
          "placeholder": "http://192.168.1.100:5700",
          "desc": "青龙面板的完整地址，如 http://192.168.1.100:5700"
        },
        {
          "id": "ql_client_id",
          "name": "青龙 Client ID",
          "val": "",
          "type": "text",
          "placeholder": "请输入 Client ID",
          "desc": "在青龙面板系统设置-应用设置中创建应用后获取"
        },
        {
          "id": "ql_client_secret",
          "name": "青龙 Client Secret",
          "val": "",
          "type": "text",
          "placeholder": "请输入 Client Secret",
          "desc": "在青龙面板系统设置-应用设置中创建应用后获取"
        },
        {
          "id": "wskeyList",
          "name": "WSKEY 列表",
          "val": "",
          "type": "textarea",
          "autoGrow": true,
          "rows": 5,
          "desc": "存储的 WSKEY 列表，JSON 格式"
        }
      ],
      "scripts": [
        {
          "name": "同步 WSKEY 到青龙",
          "script": "https://raw.githubusercontent.com/byhooi/Surge/main/Script/wskey_ql_sync.js"
        },
        {
          "name": "清空 WSKEY 列表",
          "script": "https://raw.githubusercontent.com/byhooi/Surge/main/Script/wskey_clear.js"
        }
      ],
      "author": "@byhooi",
      "repo": "https://github.com/byhooi/Surge",
      "icons": [
        "https://raw.githubusercontent.com/byhooi/Surge/main/icon/jd.png",
        "https://raw.githubusercontent.com/byhooi/Surge/main/icon/jd.png"
      ]
    },
    {
      "id": "byhooi_videourl_config",
      "name": "跳绳参数",
      "keys": [
        "DEFAULT_REQUIRED_QUALIFIED_COUNT",
        "QUALIFIED_THRESHOLD",
        "EXCELLENT_THRESHOLD"
      ],
      "descs_html": [
        "<h4 align=\"center\">配置 Script/VideoUrl.js 的默认判定阈值</h4>",
        "<p>根据实际需求调整默认合格次数、达标阈值和优秀阈值。</p>"
      ],
      "settings": [
        {
          "id": "DEFAULT_REQUIRED_QUALIFIED_COUNT",
          "name": "默认合格次数",
          "val": 3,
          "type": "number",
          "desc": "对应 DEFAULT_REQUIRED_QUALIFIED_COUNT，满足多少次合格视为通过。"
        },
        {
          "id": "QUALIFIED_THRESHOLD",
          "name": "达标跳绳数阈值",
          "val": 195,
          "type": "number",
          "desc": "对应 QUALIFIED_THRESHOLD，一分钟跳绳数达到该值计为合格。"
        },
        {
          "id": "EXCELLENT_THRESHOLD",
          "name": "优秀跳绳数阈值",
          "val": 200,
          "type": "number",
          "desc": "对应 EXCELLENT_THRESHOLD，一分钟跳绳数达到该值计为优秀。"
        }
      ],
      "author": "@byhooi",
      "repo": "https://github.com/byhooi/Surge",
      "icons": [
        "https://raw.githubusercontent.com/byhooi/Surge/main/icon/tiaosheng.png",
        "https://raw.githubusercontent.com/byhooi/Surge/main/icon/tiaosheng.png"
      ]
    },
    {
      "id": "byhooi_videourl_logs",
      "name": "跳绳日志",
      "keys": [
        "videourl_logs"
      ],
      "descs_html": [
        "<h4 align=\"center\">Script/VideoUrl.js 的运行日志记录</h4>",
        "<p>⚠️ 此区域由脚本自动更新，每次运行覆盖为最新统计结果。</p>"
      ],
      "settings": [
        {
          "id": "videourl_logs",
          "name": "最新统计记录",
          "val": "",
          "type": "textarea",
          "autoGrow": true,
          "rows": 8,
          "desc": "脚本自动生成的最新统计日志，包含考核结果、总跳绳数、总时间、视频链接等信息"
        }
      ],
      "author": "@byhooi",
      "repo": "https://github.com/byhooi/Surge",
      "icons": [
        "https://raw.githubusercontent.com/byhooi/Surge/main/icon/tiaosheng.png",
        "https://raw.githubusercontent.com/byhooi/Surge/main/icon/tiaosheng.png"
      ]
    },
    {
      "id": "tuhu_token_manager",
      "name": "途虎养车 Token 管理",
      "keys": [
        "tuhu_token"
      ],
      "descs_html": [
        "<h4 align=\"center\">管理 Script/tuhu.js 捕获的 Token</h4>",
        "<p>脚本会自动写入持久化存储，也可以在此手动更新 Token。</p>"
      ],
      "settings": [
        {
          "id": "tuhu_token",
          "name": "Token",
          "val": "",
          "type": "textarea",
          "autoGrow": true,
          "rows": 4,
          "desc": "Script/tuhu.js 自动捕获的 Token，可在此手动修改"
        }
      ],
      "author": "@byhooi",
      "repo": "https://github.com/byhooi/Surge",
      "icons": [
        "https://raw.githubusercontent.com/byhooi/Surge/main/icon/tuhu.png",
        "https://raw.githubusercontent.com/byhooi/Surge/main/icon/tuhu.png"
      ]
    },
    {
      "id": "byhooi_lggov_sign",
      "name": "龙岗图书馆多账号签到",
      "author": "@byhooi",
      "repo": "https://github.com/byhooi/Surge",
      "keys": [
        "byhooi_lggov_accounts",
        "byhooi_lggov_lock"
      ],
      "descs_html": [
        "<p>安装 lggov_sign.sgmodule 后，逐个登录或切换读者证并进入“我的”页面。账号按读者证号独立保存，默认每日 8:20 签到、每 12 小时尝试续期。</p>",
        "<p>Token 已观察到的有效窗口约 16 小时 40 分钟，续期不能保证永久有效。失效时重新登录捕获。账号 JSON 含登录凭证，请勿分享；enabled 改为 false 可停用，删除整个账号对象可移除。</p>"
      ],
      "settings": [
        {
          "id": "byhooi_lggov_accounts",
          "name": "账号列表（含敏感凭证）",
          "val": "[]",
          "type": "textarea",
          "autoGrow": true,
          "rows": 8,
          "desc": "自动捕获的 JSON 数组。请勿修改 cardno、token、expiresAt；enabled=false 停用账号；lastResult 为最近结果，lastSignDate 为最近确认成功的北京时间日期。清空为 [] 可移除全部账号。"
        },
        {
          "id": "byhooi_lggov_lock",
          "name": "任务锁（自动维护）",
          "val": "",
          "type": "text",
          "desc": "通常不要修改；任务结束自动清理，异常中断后 150 秒失效。只有提示锁数据损坏且没有任务运行时才清空此项。"
        }
      ],
      "scripts": [
        {
          "name": "手动执行多账号签到",
          "script": "https://raw.githubusercontent.com/byhooi/Surge/main/Script/lggov_sign.js",
          "script_timeout": 120
        },
        {
          "name": "手动续期全部启用账号",
          "script": "https://raw.githubusercontent.com/byhooi/Surge/main/Script/lggov_refresh.js",
          "script_timeout": 120
        }
      ]
    },
    {
      "id": "byhooi_surge",
      "name": "Surge通用重放模块",
      "author": "@byhooi",
      "repo": "https://github.com/byhooi/Surge",
      "icons": [
        "https://raw.githubusercontent.com/githubdulong/Script/master/Images/Surge_logo.png",
        "https://raw.githubusercontent.com/githubdulong/Script/master/Images/Surge_logo.png"
      ],
      "keys": [
        "byhooi_surge_retry",
        "@byhooi.record"
      ],
      "scripts": [
        {
          "name": "手动执行多账号重放(填写ckName，保存，执行)",
          "script": "https://raw.githubusercontent.com/byhooi/Surge/main/Script/surgeRecordMulti.js"
        }
      ],
      "settings": [
        {
          "id": "byhooi_surge_retry",
          "name": "ckName",
          "val": "",
          "type": "text",
          "autoGrow": true,
          "desc": "填入需要运行重放模块的ckName"
        }
      ]
    }
  ]
}
